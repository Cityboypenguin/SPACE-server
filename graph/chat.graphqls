# ルームとメッセージ。

extend type Query {
  messages(
    roomID: ID!
    limit: Int = 50
    before: ID
    after: ID
    afterTime: String
    # 指定メッセージを中心に前後 limit 件ずつ返す（返信通知や引用タップのジャンプ用）。
    # 他のカーソルより優先される。対象が削除済みなら最新ページを返す。
    around: ID
  ): MessagePage!
  room(id: ID!): Room
  myDMRooms(limit: Int = 20, offset: Int = 0): RoomPage!
}

extend type Mutation {
  createRoom(input: CreateRoomInput!): Room!
    @deprecated(reason: "Use createCommunity, getOrCreateDMRoom, or registerTimetableEntry; removal requires confirming no external clients use this mutation")
  getOrCreateDMRoom(targetUserID: ID!): Room!
  addUserToRoom(input: AddUserToRoomInput!): Boolean!
    @deprecated(reason: "Use joinRoom for communities; course membership comes from the timetable and DM membership is fixed")
  removeUserFromRoom(input: RemoveUserFromRoomInput!): Boolean!
  deleteRoom(roomID: ID!): Boolean!
  joinRoom(roomID: ID!): Boolean!
  sendMessage(
    roomID: ID!
    content: String!
    mediaInputs: [MediaUploadInput!]
    # メンション先のユーザーID（コミュニティのみ）。サジェストから選んだ相手だけが
    # メンションとして成立する。サーバー側でルームのメンバーであることと、
    # 本文に "@表示名" が残っていることを検証してから保存する。
    mentionUserIDs: [ID!]
    # 引用返信の返信先メッセージID。同じルームの未削除メッセージのみ指定できる。
    replyToID: ID
  ): Message!
  deleteMessage(roomID: ID!, id: ID!): Boolean!
  updateMessage(
    roomID: ID!
    id: ID!
    content: String!
    # メンション先のユーザーID（コミュニティのみ）。sendMessage と同じ検証を行う。
    mentionUserIDs: [ID!]
  ): Message!
  # lastReadMessageID には「画面に実際に出したうちの最後のメッセージID」を渡す。
  # 省略した場合は従来どおりサーバが受信時点の最新メッセージを既読位置にする
  # （引数を知らない古いクライアントのための互換動作）。ただしその経路では、
  # 画面に出ていない新着まで既読になる取りこぼしが起きうる。
  # 他のルームのIDや存在しないIDを渡すと INVALID_INPUT で拒否する。
  # 既読位置は前にしか進まないので、古いIDを渡しても巻き戻らない。
  markRoomAsRead(roomID: ID!, lastReadMessageID: ID): Boolean!
}

extend type Subscription {
  messageAdded(roomID: ID!): Message!
  messageDeleted(roomID: ID!): Message!
  messageUpdated(roomID: ID!): Message!
  roomReadStatusUpdated(roomID: ID!): RoomReadStatusUpdate!
}

type Room {
  ID: ID!
  content: String
  name: String!
  type: String!
  # user はそのルームの参加者。DM の相手表示に使う。
  #
  # ページングの口は持たない。コミュニティのメンバー一覧は communityMembers が
  # ページング付きで担当しており、ここに窓を足すと同じものを出す経路が2つになる。
  # 代わりにサーバー側で unpagedCollectionCap 件で頭打ちにする（大きなコミュニティの
  # ルームを開いたときに、参加者全員が1回の応答に乗らないように）。
  user: [User!]!
  createdAt: String!
  updatedAt: String!
  isMessagingDisabled: Boolean!
  lastReadAt: String
  # 自分がこのルームをどこまで読んだかを表すメッセージID。まだ一度も読んでいない
  # （または列が追加される前から既読位置を時刻でしか持っていない）なら null。
  #
  # unreadCount と同じ起点なので、未読ページの取得は messages(after:) にこの値を
  # 渡すこと。lastReadAt（秒解像度）を afterTime に渡すと、既読を打った秒と同じ秒に
  # 届いたメッセージが「未読件数には入るのにページには出てこない」という食い違いを
  # 起こす。null のときだけ従来どおり afterTime へフォールバックする。
  lastReadMessageID: ID
  unreadCount: Int!
  partnerLastReadAt: String
}

type Message {
  ID: ID!
  roomID: ID!
  room: Room!
  userID: ID!
  user: User!
  content: String!
  media: [Media!]!
  createdAt: String!
  updatedAt: String!
  isMine: Boolean!
  # 引用返信の返信先。replyToID があるのに replyTo が null なら、返信先は削除済み。
  replyToID: ID
  replyTo: Message
  # 本文中のメンション。コミュニティのみ。
  mentions: [Mention!]!
}

type MessagePage {
  items: [Message!]!
  hasMoreBefore: Boolean!
  hasMoreAfter: Boolean!
}

input CreateRoomInput {
  name: String!
}

input UpdateRoomInput {
  name: String
}

input AddUserToRoomInput {
  roomID: ID!
  userID: ID!
}

input RemoveUserFromRoomInput {
  roomID: ID!
  userID: ID!
}

type RoomPage {
  items: [Room!]!
  total: Int!
}

type RoomReadStatusUpdate {
  userID: ID!
  lastReadAt: String!
}
