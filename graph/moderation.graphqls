# 通報と問い合わせ。

extend type Query {
  searchReports(
    filter: ReportSearchFilter
    limit: Int = 20
    offset: Int = 0
  ): ReportPage!
  getReport(id: ID!): UserReport
  reportNotificationRecipients: [ReportNotificationRecipient!]!
  searchInquiries(
    status: InquiryStatus
    limit: Int = 20
    offset: Int = 0
  ): InquiryPage!
  getInquiry(id: ID!): Inquiry
  isReportServiceEnabled: Boolean!
}

extend type Mutation {
  freezeUser(id: ID!): Boolean!
  unfreezeUser(id: ID!): Boolean!
  createReport(input: CreateReportInput!): UserReport!
  updateReportStatus(id: ID!, status: ReportStatus!): UserReport!
  addReportNotificationRecipient(email: String!): ReportNotificationRecipient!
  removeReportNotificationRecipient(id: ID!): Boolean!
  createInquiry(input: CreateInquiryInput!): Inquiry!
  updateInquiryStatus(id: ID!, status: InquiryStatus!): Inquiry!
  setReportServiceStatus(enabled: Boolean!): Boolean!
}

enum InquiryStatus {
  PENDING # 未対応
  IN_PROGRESS # 対応中
  RESOLVED # 解決済み
}

enum InquiryCategory {
  DM
  POST
  COMMUNITY
  PASSWORD
  LOGIN
  OTHER
}

type Inquiry {
  id: ID!
  name: String!
  email: String!
  category: InquiryCategory!
  subject: String!
  content: String!
  status: InquiryStatus!
  createdAt: String!
  updatedAt: String!
}

type InquiryPage {
  items: [Inquiry!]!
  total: Int!
}

input CreateInquiryInput {
  name: String!
  email: String!
  category: InquiryCategory!
  subject: String!
  content: String!
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  USER
  COMMUNITY
  MESSAGE
  QUESTION
  ANSWER
  POLL
}

type UserReport {
  ID: ID!
  reporter: User!
  targetType: ReportTargetType!
  targetID: ID!
  reason: String!
  customReason: String
  status: ReportStatus!
  createdAt: String!
  updatedAt: String!
  content: String
  # 通報を受けた時点の内容。targetType が MESSAGE・QUESTION・ANSWER・POLL のときだけ入る。
  # 管理者向けの応答だけに載せ、createReport の応答（通報者）には載せない。
  reportedContent: ReportedContent
}

# 通報を受けた時点の内容。あとから編集・削除されても変わらない。
type ReportedContent {
  roomID: ID!
  roomType: String!
  roomName: String!
  # 投稿者の利用者ID。授業内チャットが匿名表示だった時期の通報は null（authorName は匿名ラベル）。
  authorID: ID
  authorName: String!
  authorAccountID: String
  # メッセージ・質問・回答の本文、または投票の設問。
  content: String!
  media: [Media!]!
  # スタンプだけのメッセージのスタンプのID。このとき content は空。
  stampID: String
  # 質問・回答への追記（古い順）。
  addenda: [String!]!
  # 回答が答えている質問の本文。回答の通報だけで入る。
  parentBody: String
  # 投票の選択肢。投票の通報だけで入り、投票した人は含まない。
  pollOptions: [String!]!
  createdAt: String!
  updatedAt: String!
}

# 通報を受け付けたときにお知らせメールを送る宛先。
type ReportNotificationRecipient {
  ID: ID!
  email: String!
  createdAt: String!
}

input ReportSearchFilter {
  status: ReportStatus
  targetType: ReportTargetType
  reporterID: ID
}

input CreateReportInput {
  targetType: ReportTargetType!
  targetID: ID! # 通報対象のID
  reason: String! # 理由の分類
  customReason: String # 詳細理由
}

type ReportPage {
  items: [UserReport!]!
  total: Int!
}
