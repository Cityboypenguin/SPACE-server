# 通知。

extend type Query {
  myNotifications(limit: Int = 20, offset: Int = 0, type: String, actorID: ID): NotificationPage!
  myNotificationGroups(limit: Int = 20, offset: Int = 0): NotificationGroupPage!
  notification(id: ID!): Notification
  myUnreadNotificationCount: Int!
  myUnreadDMCount: Int!
  myUnreadCommunityCount: Int!
}

extend type Mutation {
  markNotificationAsRead(id: ID!): Boolean!
  markAllNotificationsAsRead: Boolean!
  markAllNotificationsAsReadByActor(type: String!, actorID: ID!): Boolean!
  deleteNotifications(ids: [ID!]!): Boolean!
  deleteReadNotifications: Boolean!
  deleteReadNotificationsByActor(type: String!, actorID: ID!): Boolean!
  # 通知の SSE（/events）へ繋ぐための使い捨てチケットを発行する。
  #
  # ブラウザ標準の EventSource はカスタムヘッダーを送れないため、/events の認証情報は
  # URL に載せるしかない。アクセストークンをそのまま載せるとアクセスログやプロキシに
  # 残って有効期限まで再利用できてしまうので、代わりに「1回使ったら無効・30秒で失効」
  # するチケットを載せる。接続の直前に1枚取り、?ticket= に付けて繋ぐこと。
  # 再接続のたびに取り直す（使い回しはできない）。
  issueNotificationStreamTicket: String!
}

type Notification {
  ID: ID!
  type: String!
  actor: User
  targetType: String
  targetID: ID
  targetPost: Post
  # targetType が "message" のときの対象メッセージ（返信通知の遷移先）。
  # 削除済みなら null。
  targetMessage: Message
  message: String!
  isRead: Boolean!
  createdAt: String!
}

# 送信者・対象単位でまとめた通知の集計行（DMなど）
type NotificationGroup {
  key: String!
  type: String!
  actor: User
  targetType: String
  targetID: ID
  targetPost: Post
  targetMessage: Message
  message: String!
  createdAt: String!
  count: Int!
  unreadCount: Int!
  latestID: ID!
}

type NotificationGroupPage {
  items: [NotificationGroup!]!
  total: Int!
}

type NotificationPage {
  items: [Notification!]!
  total: Int!
}
