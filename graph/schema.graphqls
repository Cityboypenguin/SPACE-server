# GraphQL schema example
#
# https://gqlgen.com/getting-started/
type Query {
  users(limit: Int = 20, offset: Int = 0): UserPage!
  me: User!
  # 未設定（サーバー側にまだ明示的な選択が保存されていない）なら null。
  # 初期表示はクライアント側で localStorage / prefers-color-scheme から決める。
  themePreference: ThemePreference
  getUserByID(id: ID!): User
  searchUsers(keyword: String!, limit: Int = 20, offset: Int = 0): UserPage!
  myNotifications(limit: Int = 20, offset: Int = 0, type: String, actorID: ID): NotificationPage!
  myNotificationGroups(limit: Int = 20, offset: Int = 0): NotificationGroupPage!
  notification(id: ID!): Notification
  myUnreadNotificationCount: Int!
  myUnreadDMCount: Int!
  myUnreadCommunityCount: Int!

  administrators(limit: Int = 20, offset: Int = 0): AdministratorPage!
  getAdministratorByID(id: ID!): Administrator
  searchAdministrators(name: String!): [Administrator!]!

  posts(limit: Int = 20, offset: Int = 0): PostPage!
  topLevelPosts(limit: Int = 20, offset: Int = 0): PostPage!
  followersTopLevelPosts(
    userID: ID!
    limit: Int = 20
    offset: Int = 0
  ): PostPage!
  newFeedPostsCount(since: String!): Int!
  getRootPost(id: ID!): Post
  getPostByID(id: ID!): Post
  getPostByIDIncludeDeleted(id: ID!): Post
  getPostsByUserID(user_id: ID!, limit: Int = 20, offset: Int = 0): PostPage!
  getRepliesByPostID(post_id: ID!): [Post!]!
  getFavoritePostsByUserID(
    user_id: ID!
    limit: Int = 20
    offset: Int = 0
  ): PostPage!
  searchPosts(keyword: String!): [Post!]!
  searchPostsByHashtag(tag: String!): [Post!]!
  popularHashtags: HashtagSuggestionPage!
  suggestHashtags(prefix: String!, limit: Int = 8): [HashtagSuggestion!]!

  favorites: [Favorite!]!
  getFavoriteByID(id: ID!): Favorite
  myProfile: Profile
  getProfileByUserID(userID: ID!): Profile
  messages(
    roomID: ID!
    limit: Int = 50
    before: ID
    after: ID
    afterTime: String
  ): MessagePage!
  room(id: ID!): Room
  myDMRooms(limit: Int = 20, offset: Int = 0): RoomPage!
  myCommunities(limit: Int = 20, offset: Int = 0): CommunityPage!
  searchCommunities(
    name: String!
    limit: Int = 20
    offset: Int = 0
  ): CommunityPage!
  communities(limit: Int = 20, offset: Int = 0): CommunityPage!
  randomCommunities(limit: Int!): [Community!]!
  getMyRoleInCommunity(communityID: ID!): String!
  getCommunityMembers(communityID: ID!): [CommunityMember!]!
  presignedAvatarUploadUrl(contentType: String!): PresignedUploadUrl!
  presignedMediaUploadUrl(contentType: String!): PresignedUploadUrl!
  presignedCommunityIconUploadUrl(contentType: String!): PresignedUploadUrl!
  presignedTermsDocumentUploadUrl: PresignedUploadUrl!
  searchReports(
    filter: ReportSearchFilter
    limit: Int = 20
    offset: Int = 0
  ): ReportPage!
  searchInquiries(
    status: InquiryStatus
    limit: Int = 20
    offset: Int = 0
  ): InquiryPage!
  getInquiry(id: ID!): Inquiry

  announcements(limit: Int = 20, offset: Int = 0): AnnouncementPage!
  announcement(id: ID!): Announcement!
  adminListAnnouncements(limit: Int = 20, offset: Int = 0): AnnouncementPage!

  maintenanceMode: Boolean!

  currentTerms: TermsOfService
  myTermsConsentStatus: TermsConsentStatus!

  adminListTerms: [TermsOfService!]!
  adminListConsents(
    termsID: ID!
    limit: Int = 20
    offset: Int = 0
  ): TermsConsentPage!

  listFavoriteUsers(limit: Int = 20, offset: Int = 0): UserPage!
  myFollowers(limit: Int = 20, offset: Int = 0): UserPage!
  searchFavoriteUsers(keyword: String!): [User!]!
  GetFavoriteUsersByUserID(userID: ID!): [User!]!
  adminGetFavoriteUsers(userID: ID!): [User!]!

  listBlockedUsers(limit: Int = 20, offset: Int = 0): UserPage!
  searchBlockedUsers(keyword: String!): [User!]!
  GetBlockersByUserID(userID: ID!): [User!]!
  adminGetBlockers(userID: ID!): [User!]!

  isReportServiceEnabled: Boolean!

  adminGetAnalytics: AnalyticsSummary!
  adminGetCommunityAnalytics(limit: Int = 20, offset: Int = 0): CommunityStatsPage!
  adminGetTimeSeries(granularity: TimeSeriesGranularity!, from: String!, to: String!): TimeSeriesData!

  searchCourses(
    dayOfWeek: String!
    period: Int!
    keyword: String
    limit: Int = 50
    offset: Int = 0
  ): CoursePage!
  myTimetable(year: Int, semester: String): [TimetableEntry!]!
  currentSemester: CurrentSemester!
  courseYears: [Int!]!
  questions(roomID: ID!, limit: Int = 50, offset: Int = 0): QuestionPage!
  question(id: ID!): Question
  polls(roomID: ID!, limit: Int = 50, offset: Int = 0): PollPage!
  poll(id: ID!): Poll
  adminCourseImportStatus: CourseImportStatus!
  adminListCourseYears: [Int!]!
  adminListCourses(
    year: Int
    semester: String
    dayOfWeek: String
    keyword: String
    limit: Int = 20
    offset: Int = 0
  ): CoursePage!
}

type User {
  ID: ID!
  accountID: String!
  name: String!
  email: String!
  role: String!
  status: String!
  avatarUrl: String
  createdAt: String!
  updatedAt: String!
  posts: [Post!]!
  favorites: [Favorite!]!
}

type UserPage {
  items: [User!]!
  total: Int!
}

type PresignedUploadUrl {
  uploadUrl: String!
  objectKey: String!
}

type Administrator {
  ID: ID!
  name: String!
  email: String!
  createdAt: String!
  updatedAt: String!
}

type AdministratorPage {
  items: [Administrator!]!
  total: Int!
}

type Media {
  ID: ID!
  url: String!
  contentType: String!
  createdAt: String!
}

type Post {
  ID: ID!
  content: String!
  createdAt: String!
  updatedAt: String!
  deletedAt: String
  replyCount: Int!
  user: User!
  rootPost: Post
  favorites: [Favorite!]!
  parent: Post
  replies: [Post!]!
  media: [Media!]!
}

type Favorite {
  ID: ID!
  user: User!
  post: Post!
  createdAt: String!
}

type FavoriteUser {
  ID: ID!
  userID: ID!
  favoriteUserID: ID!
  createdAt: String!
}

type Blocker {
  ID: ID!
  userID: ID!
  blockedUserID: ID!
  createdAt: String!
}

type UserAuthPayload {
  token: String!
  refreshToken: String!
  user: User!
}

type AdministratorAuthPayload {
  token: String!
  refreshToken: String!
  administrator: Administrator!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  sendEmailOTP(email: String!): Boolean!
  verifyEmailOTP(email: String!, otp: String!): Boolean!
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  deleteMyAccount: Boolean!
  updateUser(input: UpdateUserInput!): User!
  loginUser(input: LoginInput!): UserAuthPayload!
  refreshUserToken(refreshToken: String!): UserAuthPayload!
  logoutUser(token: String!): Boolean!
  requestPasswordReset(email: String!): Boolean!
  verifyPasswordResetOTP(email: String!, otp: String!): String!
  resetPassword(resetToken: String!, newPassword: String!): Boolean!

  createAdministrator(input: CreateAdministratorInput!): Administrator!
  deleteAdministrator(id: ID!): Boolean!
  updateAdministrator(id: ID!, input: UpdateAdministratorInput!): Administrator!
  loginAdministrator(input: LoginInput!): AdministratorAuthPayload!
  refreshAdministratorToken(refreshToken: String!): AdministratorAuthPayload!
  logoutAdministrator(token: String!): Boolean!

  createPost(input: CreatePostInput!): Post!
  deletePost(id: ID!): Boolean!
  updatePost(input: UpdatePostInput!): Post!

  createFavorite(input: CreateFavoriteInput!): Favorite!
  deleteFavorite(input: DeleteFavoriteInput!): Boolean!
  updateProfile(input: UpdateProfileInput!): Profile!
  createRoom(input: CreateRoomInput!): Room!
  getOrCreateDMRoom(targetUserID: ID!): Room!
  addUserToRoom(input: AddUserToRoomInput!): Boolean!
  removeUserFromRoom(input: RemoveUserFromRoomInput!): Boolean!
  deleteRoom(roomID: ID!): Boolean!
  createCommunity(input: CreateCommunityInput!): Community!
  registerTimetableEntry(courseID: ID!): TimetableEntry!
  removeTimetableEntry(id: ID!): Boolean!
  setTimetableEntryColor(id: ID!, color: TimetableEntryColor!): TimetableEntry!
  # 「編集モード」の一括確定用。year/semester の時間割を courseIDs の内容に丸ごと
  # 置き換える（1トランザクション）。baselineEntryIDs が現在の登録内容と一致しない
  # 場合（他タブでの変更等）は何も変更せず CONFLICT エラーを返す。
  setMyTimetable(
    year: Int!
    semester: String!
    baselineEntryIDs: [ID!]!
    courseIDs: [ID!]!
  ): [TimetableEntry!]!
  updateCurrentSemester(year: Int!, semester: String!): CurrentSemester!
  createQuestion(roomID: ID!, body: String!): Question!
  answerQuestion(questionID: ID!, body: String!): Answer!
  selectBestAnswer(questionID: ID!, answerID: ID!): Question!
  createPoll(roomID: ID!, question: String!, options: [String!]!, allowMultipleChoice: Boolean = false): Poll!
  votePoll(pollID: ID!, optionIDs: [ID!]!): Poll!
  adminTriggerCourseImport(year: Int!): CourseImportStatus!
  adminUpdateUser(id: ID!, input: UpdateUserInput!): User!
  adminUpdateProfile(userID: ID!, input: UpdateProfileInput!): Profile!
  updateCommunity(id: ID!, input: UpdateCommunityInput!): Community!
  kickUserFromCommunity(communityID: ID!, userID: ID!): Boolean!
  promoteToCommunityOwner(communityID: ID!, userID: ID!): Boolean!
  demoteFromCommunityOwner(communityID: ID!, userID: ID!): Boolean!
  updateCommunityMembers(
    communityID: ID!
    updates: [CommunityMemberUpdateInput!]!
  ): Boolean!
  adminDeletePost(id: ID!): Boolean!
  freezeUser(id: ID!): Boolean!
  unfreezeUser(id: ID!): Boolean!
  setAvatar(objectKey: String!): Profile!
  deleteAvatar: Profile!
  joinRoom(roomID: ID!): Boolean!
  sendMessage(
    roomID: ID!
    content: String!
    mediaInputs: [MediaUploadInput!]
  ): Message!
  deleteMessage(roomID: ID!, id: ID!): Boolean!
  updateMessage(roomID: ID!, id: ID!, content: String!): Message!

  createReport(input: CreateReportInput!): UserReport!
  updateReportStatus(id: ID!, status: ReportStatus!): UserReport!

  createFavoriteUser(favoriteUserID: ID!): FavoriteUser!
  deleteFavoriteUser(favoriteUserID: ID!): Boolean!

  createBlocker(blockedUserID: ID!): Blocker!
  deleteBlocker(blockedUserID: ID!): Boolean!
  createInquiry(input: CreateInquiryInput!): Inquiry!
  updateInquiryStatus(id: ID!, status: InquiryStatus!): Inquiry!
  markNotificationAsRead(id: ID!): Boolean!
  markAllNotificationsAsRead: Boolean!
  markAllNotificationsAsReadByActor(type: String!, actorID: ID!): Boolean!
  deleteNotifications(ids: [ID!]!): Boolean!
  deleteReadNotifications: Boolean!
  deleteReadNotificationsByActor(type: String!, actorID: ID!): Boolean!

  createAnnouncement(input: CreateAnnouncementInput!): Announcement!
  updateAnnouncement(id: ID!, input: UpdateAnnouncementInput!): Announcement!
  deleteAnnouncement(id: ID!): Boolean!
  markRoomAsRead(roomID: ID!): Boolean!

  createTermsOfService(input: CreateTermsOfServiceInput!): TermsOfService!
  consentToTerms(termsID: ID!): Boolean!

  toggleMaintenanceMode(enabled: Boolean!): Boolean!
  setReportServiceStatus(enabled: Boolean!): Boolean!

  setThemePreference(theme: ThemePreference!): ThemePreference!

  recordSessionData(input: RecordSessionDataInput!): Boolean!
}

type Announcement {
  ID: ID!
  title: String!
  body: String!
  createdAt: String!
  updatedAt: String!
}

input CreateAnnouncementInput {
  title: String!
  body: String!
}

input UpdateAnnouncementInput {
  title: String!
  body: String!
}

enum InquiryStatus {
  PENDING # 未対応
  IN_PROGRESS # 対応中
  RESOLVED # 解決済み
}

enum InquiryCategory {
  DM
  POST
  COMMUNITY
  PASSWORD
  LOGIN
  OTHER
}

type Inquiry {
  id: ID!
  name: String!
  email: String!
  category: InquiryCategory!
  subject: String!
  content: String!
  status: InquiryStatus!
  createdAt: String!
  updatedAt: String!
}

type InquiryPage {
  items: [Inquiry!]!
  total: Int!
}

input CreateInquiryInput {
  name: String!
  email: String!
  category: InquiryCategory!
  subject: String!
  content: String!
}

input MediaUploadInput {
  objectKey: String!
  contentType: String!
}

input CreateAdministratorInput {
  name: String!
  email: String!
  password: String!
}

input UpdateAdministratorInput {
  name: String
  email: String
  password: String
}

input CreateUserInput {
  accountID: String!
  name: String!
  email: String!
  password: String!
  otp: String!
}

input UpdateUserInput {
  accountID: String
  name: String
  email: String
  password: String
  currentPassword: String
}

input CreatePostInput {
  content: String!
  parent_id: ID
  mediaInputs: [MediaUploadInput!]
}

input UpdatePostInput {
  id: ID!
  content: String!
  newMediaInputs: [MediaUploadInput!]
  deletedMediaIDs: [ID!]
}

type Profile {
  user: User!
  username: String!
  bio: String
  avatarUrl: String
  createdAt: String!
  updatedAt: String!
}

input UpdateProfileInput {
  username: String
  bio: String
}

type Room {
  ID: ID!
  content: String
  name: String!
  type: String!
  user: [User!]!
  createdAt: String!
  updatedAt: String!
  isMessagingDisabled: Boolean!
  lastReadAt: String
  unreadCount: Int!
  partnerLastReadAt: String
}

input CreateFavoriteInput {
  post_id: ID!
}

input DeleteFavoriteInput {
  post_id: ID!
}
type Message {
  ID: ID!
  roomID: ID!
  room: Room!
  userID: ID!
  user: User!
  content: String!
  media: [Media!]!
  createdAt: String!
  updatedAt: String!
  isMine: Boolean!
}

type MessagePage {
  items: [Message!]!
  hasMoreBefore: Boolean!
  hasMoreAfter: Boolean!
}

input CreateRoomInput {
  name: String!
}

input UpdateRoomInput {
  name: String
}

input AddUserToRoomInput {
  roomID: ID!
  userID: ID!
}

input RemoveUserFromRoomInput {
  roomID: ID!
  userID: ID!
}

type Community {
  ID: ID!
  roomID: ID!
  name: String!
  description: String!
  avatarURL: String!
  memberCount: Int!
  isMember: Boolean!
  unreadCount: Int!
  lastMessage: String
  createdAt: String!
  updatedAt: String!
}

type CommunityPage {
  items: [Community!]!
  total: Int!
}

type RoomPage {
  items: [Room!]!
  total: Int!
}

type CommunityMember {
  user: User!
  role: String!
}

input CreateCommunityInput {
  name: String!
  description: String!
  avatarKey: String
}

input UpdateCommunityInput {
  name: String
  description: String
  avatarKey: String
}

enum CommunityMemberAction {
  PROMOTE
  DEMOTE
  KICK
}

input CommunityMemberUpdateInput {
  userID: ID!
  action: CommunityMemberAction!
}

type RoomReadStatusUpdate {
  userID: ID!
  lastReadAt: String!
}

type Course {
  ID: ID!
  roomID: ID!
  dayOfWeek: String!
  period: Int!
  teacherName: String!
  courseName: String!
  year: Int!
  semester: String!
  createdAt: String!
}

type CoursePage {
  items: [Course!]!
  total: Int!
}

type TimetableEntry {
  ID: ID!
  course: Course!
  color: TimetableEntryColor!
  createdAt: String!
}

# 時間割のコマに表示する色。ユーザーは自由な色ではなく、この決まったパレットから選ぶ。
enum TimetableEntryColor {
  BLUE
  GREEN
  PURPLE
  PINK
  ORANGE
  TEAL
  RED
  YELLOW
}

type CurrentSemester {
  year: Int!
  semester: String!
}

enum CourseImportState {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

type CourseImportStatus {
  state: CourseImportState!
  year: Int
  imported: Int
  skipped: Int
  errorMessage: String
  startedAt: String
  finishedAt: String
}

type Question {
  ID: ID!
  roomID: ID!
  user: User!
  body: String!
  isAnswered: Boolean!
  bestAnswer: Answer
  answers: [Answer!]!
  createdAt: String!
  updatedAt: String!
  isMine: Boolean!
}

type Answer {
  ID: ID!
  questionID: ID!
  user: User!
  body: String!
  createdAt: String!
  isMine: Boolean!
}

type QuestionPage {
  items: [Question!]!
  total: Int!
}

type Poll {
  ID: ID!
  roomID: ID!
  user: User!
  question: String!
  allowMultipleChoice: Boolean!
  options: [PollOption!]!
  createdAt: String!
}

type PollOption {
  ID: ID!
  label: String!
  voteCount: Int!
  votedByMe: Boolean!
}

type PollPage {
  items: [Poll!]!
  total: Int!
}

type Subscription {
  messageAdded(roomID: ID!): Message!
  messageDeleted(roomID: ID!): Message!
  messageUpdated(roomID: ID!): Message!
  roomReadStatusUpdated(roomID: ID!): RoomReadStatusUpdate!
  questionAdded(roomID: ID!): Question!
  questionUpdated(roomID: ID!): Question!
  answerAdded(questionID: ID!): Answer!
  pollAdded(roomID: ID!): Poll!
  pollUpdated(pollID: ID!): Poll!
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  USER
  COMMUNITY
}

type UserReport {
  ID: ID!
  reporter: User!
  targetType: ReportTargetType!
  targetID: ID!
  reason: String!
  customReason: String
  status: ReportStatus!
  createdAt: String!
  updatedAt: String!
  content: String
}

input ReportSearchFilter {
  status: ReportStatus
  targetType: ReportTargetType
  reporterID: ID
}

type Notification {
  ID: ID!
  type: String!
  actor: User
  targetType: String
  targetID: ID
  targetPost: Post
  message: String!
  isRead: Boolean!
  createdAt: String!
}

# 送信者・対象単位でまとめた通知の集計行（DMなど）
type NotificationGroup {
  key: String!
  type: String!
  actor: User
  targetType: String
  targetID: ID
  targetPost: Post
  message: String!
  createdAt: String!
  count: Int!
  unreadCount: Int!
  latestID: ID!
}

type NotificationGroupPage {
  items: [NotificationGroup!]!
  total: Int!
}

input CreateReportInput {
  targetType: ReportTargetType!
  targetID: ID! # 通報対象のID
  reason: String! # 理由の分類
  customReason: String # 詳細理由
}

type TermsOfService {
  ID: ID!
  version: String!
  documentUrl: String!
  effectiveDate: String!
  createdAt: String!
}

type TermsConsentStatus {
  isConsented: Boolean!
  currentTerms: TermsOfService
}

type TermsConsentRecord {
  ID: ID!
  user: User!
  consentedAt: String!
}

type PostPage {
  items: [Post!]!
  total: Int!
}

type HashtagSuggestion {
  tag: String!
  count: Int!
}

# items は人気上位のタグ（最大 500 件）。total はタグの種類数。
# total <= items の件数なら全タグを先読みできている（complete）と判断できる。
type HashtagSuggestionPage {
  items: [HashtagSuggestion!]!
  total: Int!
}

type ReportPage {
  items: [UserReport!]!
  total: Int!
}

type AnnouncementPage {
  items: [Announcement!]!
  total: Int!
}

type NotificationPage {
  items: [Notification!]!
  total: Int!
}

type TermsConsentPage {
  items: [TermsConsentRecord!]!
  total: Int!
}

input CreateTermsOfServiceInput {
  version: String!
  objectKey: String!
  effectiveDate: String!
}

type AnalyticsSummary {
  # 基本集計
  totalUsers: Int!
  newUsersToday: Int!
  newUsersThisWeek: Int!
  newUsersThisMonth: Int!
  frozenUsersCount: Int!
  totalPosts: Int!
  totalComments: Int!
  totalDeletedPosts: Int!
  totalLikes: Int!
  totalCommunities: Int!
  totalMessages: Int!
  totalReports: Int!
  totalBlocks: Int!
  totalInquiries: Int!

  # アクティビティ
  currentActiveUsers: Int!
  dau: Int!
  wau: Int!
  mau: Int!
  dauMauRatio: Float!

  # コンテンツ（日次）
  postsToday: Int!
  commentsToday: Int!
  messagesToday: Int!

  # エンゲージメント
  avgLikesPerPost: Float!
  avgCommentsPerPost: Float!

  # 投稿種別
  postsTextOnly: Int!
  postsWithImage: Int!
  postsWithVideo: Int!

  # DM
  uniqueDMSenders: Int!

  # コミュニティ
  activeCommunitiesLast30Days: Int!
  avgCommunityMembers: Float!
  avgCommunitiesPerUser: Float!

  # ソーシャル
  totalFollows: Int!
  avgFollowersPerUser: Float!
  avgFollowingPerUser: Float!

  # オンボーディング
  usersWithProfile: Int!
  usersWithAvatar: Int!
  usersWithPost: Int!
  onboardingCompleteRate: Float!
  avgTimeToFirstPostMinutes: Float!

  # 通知
  totalNotifications: Int!
  readNotifications: Int!
  notificationReadRate: Float!

  # 通報ステータス
  pendingReports: Int!
  resolvedReports: Int!

  # インフラ（in-memory）
  webSocketConnections: Int!
  sseConnections: Int!
  errorRate5xx: Float!
  p50ResponseTimeMs: Float!
  p95ResponseTimeMs: Float!
  p99ResponseTimeMs: Float!

  # セッション（クライアント送信）
  avgSessionDurationSeconds: Float!
  avgSessionsPerDay: Float!
  avgScrollDepth: Float!
  pageViewStats: [PageViewStat!]!
}

type PageViewStat {
  pagePath: String!
  avgDurationSeconds: Float!
  avgMaxScrollDepth: Float!
  totalViews: Int!
}

type CommunityStatItem {
  communityID: ID!
  name: String!
  memberCount: Int!
  messageCount: Int!
}

type CommunityStatsPage {
  items: [CommunityStatItem!]!
  total: Int!
}

input RecordSessionDataInput {
  sessionDurationSeconds: Int!
  pageViews: [PageViewInput!]!
}

input PageViewInput {
  path: String!
  durationSeconds: Int!
  maxScrollDepth: Int!
}

enum TimeSeriesGranularity {
  day
  hour
}

enum ThemePreference {
  LIGHT
  DARK
}

type TimeSeriesPoint {
  label: String!
  posts: Int!
  comments: Int!
  messages: Int!
  newUsers: Int!
  likes: Int!
  activeUsers: Int!
}

type TimeSeriesData {
  points: [TimeSeriesPoint!]!
}
