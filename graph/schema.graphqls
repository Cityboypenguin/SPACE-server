# GraphQL schema example
#
# https://gqlgen.com/getting-started/
type Query {
  users: [User!]!
  me: User!
  getUserByID(id: ID!): User
  searchUsers(keyword: String!): [User!]!
  myNotifications(limit: Int): [Notification!]!
  myUnreadNotificationCount: Int!

  administrators: [Administrator!]!
  getAdministratorByID(id: ID!): Administrator
  searchAdministrators(name: String!): [Administrator!]!

  posts: [Post!]!
  topLevelPosts: [Post!]!
  getPostByID(id: ID!): Post
  getRepliesByPostID(post_id: ID!): [Post!]!
  searchPosts(content: String!): [Post!]!

  favorites: [Favorite!]!
  getFavoriteByID(id: ID!): Favorite
  myProfile: Profile
  getProfileByUserID(userID: ID!): Profile
  messages(roomID: ID!): [Message!]!
  room(id: ID!): Room
  myDMRooms: [Room!]!
  myCommunities: [Community!]!
  searchCommunities(name: String!): [Community!]!
  communities: [Community!]!
  randomCommunities(limit: Int!): [Community!]!
  getMyRoleInCommunity(communityID: ID!): String!
  getCommunityMembers(communityID: ID!): [CommunityMember!]!
  presignedAvatarUploadUrl(contentType: String!): PresignedUploadUrl!
  presignedMediaUploadUrl(contentType: String!): PresignedUploadUrl!
  presignedCommunityIconUploadUrl(contentType: String!): PresignedUploadUrl!
  searchReports(filter: ReportSearchFilter): [UserReport!]!
}

type User {
  ID: ID!
  accountID: String!
  name: String!
  email: String!
  role: String!
  status: String!
  avatarUrl: String
  createdAt: String!
  updatedAt: String!
  posts: [Post!]!
  favorites: [Favorite!]!
}

type PresignedUploadUrl {
  uploadUrl: String!
  objectKey: String!
}

type Administrator {
  ID: ID!
  name: String!
  email: String!
  createdAt: String!
  updatedAt: String!
}

type Media {
  ID: ID!
  url: String!
  contentType: String!
  createdAt: String!
}

type Post {
  ID: ID!
  content: String!
  createdAt: String!
  updatedAt: String!
  deletedAt: String
  replyCount: Int!
  user: User!
  favorites: [Favorite!]!
  parent: Post
  replies: [Post!]!
  media: [Media!]!
}

type Favorite {
  ID: ID!
  user: User!
  post: Post!
  createdAt: String!
}

type UserAuthPayload {
  token: String!
  refreshToken: String!
  user: User!
}

type AdministratorAuthPayload {
  token: String!
  refreshToken: String!
  administrator: Administrator!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  updateUser(input: UpdateUserInput!): User!
  loginUser(input: LoginInput!): UserAuthPayload!
  refreshUserToken(refreshToken: String!): UserAuthPayload!
  logoutUser(token: String!): Boolean!

  createAdministrator(input: CreateAdministratorInput!): Administrator!
  deleteAdministrator(id: ID!): Boolean!
  updateAdministrator(id: ID!, input: UpdateAdministratorInput!): Administrator!
  loginAdministrator(input: LoginInput!): AdministratorAuthPayload!
  refreshAdministratorToken(refreshToken: String!): AdministratorAuthPayload!
  logoutAdministrator(token: String!): Boolean!

  createPost(input: CreatePostInput!): Post!
  deletePost(id: ID!): Boolean!
  updatePost(input: UpdatePostInput!): Post!

  createFavorite(input: CreateFavoriteInput!): Favorite!
  deleteFavorite(input: DeleteFavoriteInput!): Boolean!
  updateProfile(input: UpdateProfileInput!): Profile!
  createRoom(input: CreateRoomInput!): Room!
  getOrCreateDMRoom(targetUserID: ID!): Room!
  addUserToRoom(input: AddUserToRoomInput!): Boolean!
  removeUserFromRoom(input: RemoveUserFromRoomInput!): Boolean!
  createCommunity(input: CreateCommunityInput!): Community!
  adminUpdateUser(id: ID!, input: UpdateUserInput!): User!
  adminUpdateProfile(userID: ID!, input: UpdateProfileInput!): Profile!
  updateCommunity(id: ID!, input: UpdateCommunityInput!): Community!
  kickUserFromCommunity(communityID: ID!, userID: ID!): Boolean!
  promoteToCommunityOwner(communityID: ID!, userID: ID!): Boolean!
  demoteFromCommunityOwner(communityID: ID!, userID: ID!): Boolean!
  adminDeletePost(id: ID!): Boolean!
  freezeUser(id: ID!): Boolean!
  unfreezeUser(id: ID!): Boolean!
  setAvatar(objectKey: String!): Profile!
  joinRoom(roomID: ID!): Boolean!
  sendMessage(roomID: ID!, content: String!, mediaInputs: [MediaUploadInput!]): Message!
  deleteMessage(roomID: ID!, id: ID!): Boolean!
  updateMessage(roomID: ID!, id: ID!, content: String!): Message!

  createReport(input: CreateReportInput!): UserReport!
  updateReportStatus(id: ID!, status: ReportStatus!): UserReport!
  toggleReportSystem(enabled: Boolean!): Boolean!

  createInquiry(input: CreateInquiryInput!): Inquiry!
}

type Inquiry {
  ID: ID!
  name: String!
  email: String!
  subject: String!
  content: String!
  createdAt: String!
}

input CreateInquiryInput {
  name: String!
  email: String!
  subject: String!
  content: String!

  markNotificationAsRead(id: ID!): Boolean!
  markAllNotificationsAsRead: Boolean!
}

input MediaUploadInput {
  objectKey: String!
  contentType: String!
}

input CreateAdministratorInput {
  name: String!
  email: String!
  password: String!
}

input UpdateAdministratorInput {
  name: String
  email: String
  password: String
}

input CreateUserInput {
  accountID: String!
  name: String!
  email: String!
  password: String!
}

input UpdateUserInput {
  accountID: String
  name: String
  email: String
  password: String
}

input CreatePostInput {
  content: String!
  parent_id: ID
  mediaInputs: [MediaUploadInput!]
}

input UpdatePostInput {
  id: ID!
  content: String!
}

type Profile {
  user: User!
  username: String!
  bio: String
  avatarUrl: String
  createdAt: String!
  updatedAt: String!
}

input UpdateProfileInput {
  username: String
  bio: String
}

type Room {
  ID: ID!
  content: String
  name: String!
  type: String!
  user: [User!]!
  createdAt: String!
  updatedAt: String!
}

input CreateFavoriteInput {
  post_id: ID!
}

input DeleteFavoriteInput {
  post_id: ID!
}
type Message {
  ID: ID!
  roomID: ID!
  room: Room!
  userID: ID!
  user: User!
  content: String!
  media: [Media!]!
  createdAt: String!
  updatedAt: String!
}

input CreateRoomInput {
  name: String!
}

input UpdateRoomInput {
  name: String
}

input AddUserToRoomInput {
  roomID: ID!
  userID: ID!
}

input RemoveUserFromRoomInput {
  roomID: ID!
  userID: ID!
}

type Community {
  ID: ID!
  roomID: ID!
  name: String!
  description: String!
  avatarURL: String!
  createdAt: String!
  updatedAt: String!
}

type CommunityMember {
  user: User!
  role: String!
}

input CreateCommunityInput {
  name: String!
  description: String!
  avatarKey: String
}

input UpdateCommunityInput {
  name: String
  description: String
  avatarKey: String
}

type Subscription {
  messageAdded(roomID: ID!): Message!
  messageDeleted(roomID: ID!): Message!
  messageUpdated(roomID: ID!): Message!
}

enum ReportStatus {
  PENDING    # 未対応
  REVIEWING  # 確認中
  RESOLVED   # 解決済み
  DISMISSED  # 却下（問題なし）
}

enum ReportTargetType {
  POST
  COMMENT
  PROMOTION
  COMMUNITY
}

type UserReport {
  ID: ID!
  reporter: User!        # 通報したユーザーの情報
  targetType: ReportTargetType!
  targetID: ID!          # 対象（PostやCommunityなど）のID
  reason: String!        # 通報理由の分類（スパム、嫌がらせ等）
  customReason: String   # 詳細な理由（自由記述・オプショナル）
  status: ReportStatus!
  createdAt: String!
  updatedAt: String!
}

input ReportSearchFilter {
  status: ReportStatus
  targetType: ReportTargetType
  reporterID: ID
}

type Notification {
  ID: ID!
  type: String!
  actor: User
  targetType: String
  targetID: ID
  message: String!
  isRead: Boolean!
  createdAt: String!
}

input CreateReportInput {
  targetType: ReportTargetType!
  targetID: ID!          # 通報対象のID
  reason: String!        # 理由の分類
  customReason: String   # 詳細理由
}