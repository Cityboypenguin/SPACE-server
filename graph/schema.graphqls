# GraphQL schema example
# 
# https://gqlgen.com/getting-started/
type Query {
  users: [User!]!
  getUserByID(id: ID!): User
  searchUsers(name: String!): [User!]!
  administrators: [Administrator!]!
  getAdministratorByID(id: ID!): Administrator
  searchAdministrators(name: String!): [Administrator!]!
  posts: [Post!]!
  getPostByID(id: ID!): Post
  searchPosts(content: String!): [Post!]!
  getPostByUserID(user_id: ID!): [Post!]!
  favorites: [Favorite!]!
  getFavoriteByID(id: ID!): Favorite
  comments: [Comment!]!
  getCommentByID(id: ID!): Comment
}

type User {
  ID: ID!
  accountID: String!
  name: String!
  email: String!
  role: String!
  status: String!
  createdAt: String!
  updatedAt: String!
}

type Administrator {
  ID: ID!
  name: String!
  password: String!
  email: String!
  createdAt: String!
  updatedAt: String!
}

type Post {
  ID: ID!
  user: User!
  content: String!
  picture: String #画像のURL
  movie: String #動画のURL
  hyperlink: String
  favorite_count: Int!
  createdAt: String!
  updatedAt: String!
}

type Favorite {
  ID: ID!
  user: User!
  post: Post!
  createdAt: String!
}

type Comment {
  ID: ID!
  user: User!
  post: Post!
  content: String!
  createdAt: String!
  updatedAt: String!
}

type UserAuthPayload {
  token: String!
  user: User!
}

type AdministratorAuthPayload {
  token: String!
  administrator: Administrator!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  updateUser(input: UpdateUserInput!): User!
  loginUser(input: LoginInput!): UserAuthPayload!
  logoutUser(token: String!): Boolean!
  createAdministrator(input: CreateAdministratorInput!): Administrator!
  deleteAdministrator(id: ID!): Boolean!
  updateAdministrator(input: UpdateAdministratorInput!): Administrator!
  loginAdministrator(input: LoginInput!): AdministratorAuthPayload!
  logoutAdministrator(token: String!): Boolean!
  createPost(input: CreatePostInput!): Post!
  deletePost(id: ID!): Boolean!
  updatePost(input: UpdatePostInput!): Post!
  createFavorite(input: CreateFavoriteInput!): Favorite!
  deleteFavorite(id: ID!): Boolean!
  createComment(input: CreateCommentInput!): Comment!
  deleteComment(id: ID!): Boolean!
  updateComment(input: UpdateCommentInput!): Comment!
}

input CreateAdministratorInput {
  name: String!
  email: String!
  password: String!
}

input UpdateAdministratorInput {
  ID: ID!
  name: String
  email: String
  password: String
}

input CreateUserInput {
  accountID: String!
  name: String!
  email: String!
  password: String!
}

input UpdateUserInput {
  ID: ID!
  accountID: String
  name: String
  email: String
  password: String
}

input CreatePostInput {
  user_id: ID!
  content: String!
  picture: String
  movie: String
  hyperlink: String
}

input UpdatePostInput {
  ID: ID!
  content: String
  picture: String
  movie: String
  hyperlink: String
}

input CreateFavoriteInput {
  user_id: ID!
  post_id: ID!
}

input CreateCommentInput {
  user_id: ID!
  post_id: ID!
  content: String!
}

input UpdateCommentInput {
  ID: ID!
  content: String
}