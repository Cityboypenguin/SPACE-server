# スキーマの根と、どの機能にも属さない運用向けのフィールド。
#
# 根の型（Query / Mutation / Subscription）はここにだけ定義し、機能ごとのフィールドは
# 各ファイルの extend type が足す。分けているのは、リゾルバの置き場がスキーマの
# ファイルに従う（gqlgen の layout: follow-schema）ため。1枚にまとめていた頃は
# schema.resolvers.go が5,000行あり、1つの機能を直すのに全体を探すことになっていた。
#
# API としては1枚のスキーマのままで、クライアントから見た形は変わらない。
#
# 根の型は空にできないので、運用向けのフィールドをここに置いてある
# （メンテナンスモードと取り込み状況の購読。どれも特定の機能のものではない）。
# 機能のフィールドをここへ足さないこと。

type Query {
  maintenanceMode: Boolean!
  # 授業チャットが一括停止されていないか。利用者の画面も停止中の表示に使うので、
  # ログインしていれば誰でも読める。切り替えは SSE の course_chat_status で届く。
  courseChatEnabled: Boolean!
}

type Mutation {
  toggleMaintenanceMode(enabled: Boolean!): Boolean!
  toggleCourseChat(enabled: Boolean!): Boolean!
}

type Subscription {
  # Pushes on every state/progress change of the (single, global) course-import job,
  # letting the admin screen show live progress without polling adminCourseImportStatus.
  adminCourseImportStatusUpdated: CourseImportStatus!
}
