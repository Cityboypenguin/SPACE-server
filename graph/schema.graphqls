# GraphQL schema example
#
# https://gqlgen.com/getting-started/
type Query {
  users: [User!]!
  user(userID: ID!): User
}

type User {
  ID: ID!
  userID: String!
  name: String!
  email: String!
  role: String!
  status: String!
  createdAt: String!
  updatedAt: String!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
}

input CreateUserInput {
  userID: String!
  name: String!
  email: String!
  password: String!
}