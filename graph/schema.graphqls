# GraphQL schema example
#
# https://gqlgen.com/getting-started/
type Query {
  users: [User!]!
  me: User!
  getUserByID(id: ID!): User
  searchUsers(name: String!): [User!]!

  administrators: [Administrator!]!
  getAdministratorByID(id: ID!): Administrator
  searchAdministrators(name: String!): [Administrator!]!

  posts: [Post!]!
  topLevelPosts: [Post!]!
  getPostByID(id: ID!): Post
  getRepliesByPostID(post_id: ID!): [Post!]!
  searchPosts(content: String!): [Post!]!
  
  favorites: [Favorite!]!
  getFavoriteByID(id: ID!): Favorite
  myProfile: Profile
  getProfileByUserID(userID: ID!): Profile
  messages(roomID: ID!): [Message!]!
  room(id: ID!): Room
  myDMRooms: [Room!]!
  myCommunities: [Community!]!
  searchCommunities(name: String!): [Community!]!
}

type User {
  ID: ID!
  accountID: String!
  name: String!
  email: String!
  role: String!
  status: String!
  createdAt: String!
  updatedAt: String!
  posts: [Post!]!
  favorites: [Favorite!]!
}

type Administrator {
  ID: ID!
  name: String!
  email: String!
  createdAt: String!
  updatedAt: String!
}

type Post {
  ID: ID!
  content: String!
  createdAt: String!
  updatedAt: String!
  user: User!
  favorites: [Favorite!]!
  parent: Post
  replies: [Post!]!
}

type Favorite {
  ID: ID!
  user: User!
  post: Post!
  createdAt: String!
}

type UserAuthPayload {
  token: String!
  refreshToken: String!
  user: User!
}

type AdministratorAuthPayload {
  token: String!
  refreshToken: String!
  administrator: Administrator!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  updateUser(input: UpdateUserInput!): User!
  loginUser(input: LoginInput!): UserAuthPayload!
  refreshUserToken(refreshToken: String!): UserAuthPayload!
  logoutUser(token: String!): Boolean!

  createAdministrator(input: CreateAdministratorInput!): Administrator!
  deleteAdministrator(id: ID!): Boolean!
  updateAdministrator(id: ID!, input: UpdateAdministratorInput!): Administrator!
  loginAdministrator(input: LoginInput!): AdministratorAuthPayload!
  refreshAdministratorToken(refreshToken: String!): AdministratorAuthPayload!
  logoutAdministrator(token: String!): Boolean!

  createPost(input: CreatePostInput!): Post!
  deletePost(id: ID!): Boolean!
  updatePost(input: UpdatePostInput!): Post!

  createFavorite(input: CreateFavoriteInput!): Favorite!
  deleteFavorite(input: DeleteFavoriteInput!): Boolean!
  updateProfile(input: UpdateProfileInput!): Profile!
  createRoom(input: CreateRoomInput!): Room!
  getOrCreateDMRoom(targetUserID: ID!): Room!
  addUserToRoom(input: AddUserToRoomInput!): Boolean!
  removeUserFromRoom(input: RemoveUserFromRoomInput!): Boolean!
  createCommunity(input: CreateCommunityInput!): Community!
  joinRoom(roomID: ID!): Boolean!
  sendMessage(roomID: ID!, content: String!): Message!
  deleteMessage(roomID: ID!, id: ID!): Boolean!
  updateMessage(roomID: ID!, id: ID!, content: String!): Message!
}

input CreateAdministratorInput {
  name: String!
  email: String!
  password: String!
}

input UpdateAdministratorInput {
  name: String
  email: String
  password: String
}

input CreateUserInput {
  accountID: String!
  name: String!
  email: String!
  password: String!
}

input UpdateUserInput {
  accountID: String
  name: String
  email: String
  password: String
}

input CreatePostInput {
  content: String!
  parent_id: ID
}

input UpdatePostInput {
  id: ID!
  content: String!
}

type Profile {
  user: User!
  username: String!
  bio: String
  image: String
  createdAt: String!
  updatedAt: String!
}

input UpdateProfileInput {
  username: String
  bio: String
  image: String
}

type Room {
  ID: ID!
  content: String
  name: String!
  type: String!
  user: [User!]!
  createdAt: String!
  updatedAt: String!
}

input CreateFavoriteInput {
  post_id: ID!
}

input DeleteFavoriteInput {
  post_id: ID!
}
type Message {
  ID: ID!
  roomID: ID!
  room: Room!
  userID: ID!
  user: User!
  content: String!
  createdAt: String!
  updatedAt: String!
}

input CreateRoomInput {
  name: String!
}

input UpdateRoomInput {
  name: String
}

input AddUserToRoomInput {
  roomID: ID!
  userID: ID!
}

input RemoveUserFromRoomInput {
  roomID: ID!
  userID: ID!
}

type Community {
  ID: ID!
  roomID: ID!
  name: String!
  description: String!
  createdAt: String!
  updatedAt: String!
}

input CreateCommunityInput {
  name: String!
  description: String!
}

type Subscription {
  messageAdded(roomID: ID!): Message!
  messageDeleted(roomID: ID!): Message!
  messageUpdated(roomID: ID!): Message!
}
