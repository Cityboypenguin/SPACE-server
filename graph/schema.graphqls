# GraphQL schema example
#
# https://gqlgen.com/getting-started/
type Query {
  users: [User!]!
  me: User!
  getUserByID(id: ID!): User
  searchUsers(name: String!): [User!]!
  administrators: [Administrator!]!
  getAdministratorByID(id: ID!): Administrator
  searchAdministrators(name: String!): [Administrator!]!
  myProfile: Profile
  getProfileByUserID(userID: ID!): Profile
  messages(roomID: ID!): [Message!]!
  room(id: ID!): Room
  myDMRooms: [Room!]!
  myCommunities: [Community!]!
  searchCommunities(name: String!): [Community!]!
}

type User {
  ID: ID!
  accountID: String!
  name: String!
  email: String!
  role: String!
  status: String!
  createdAt: String!
  updatedAt: String!
}

type Administrator {
  ID: ID!
  name: String!
  email: String!
  createdAt: String!
  updatedAt: String!
}

type UserAuthPayload {
  token: String!
  refreshToken: String!
  user: User!
}

type AdministratorAuthPayload {
  token: String!
  refreshToken: String!
  administrator: Administrator!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  deleteUser(id: ID!): Boolean!
  updateUser(input: UpdateUserInput!): User!
  loginUser(input: LoginInput!): UserAuthPayload!
  refreshUserToken(refreshToken: String!): UserAuthPayload!
  logoutUser(token: String!): Boolean!
  createAdministrator(input: CreateAdministratorInput!): Administrator!
  deleteAdministrator(id: ID!): Boolean!
  updateAdministrator(id: ID!, input: UpdateAdministratorInput!): Administrator!
  loginAdministrator(input: LoginInput!): AdministratorAuthPayload!
  refreshAdministratorToken(refreshToken: String!): AdministratorAuthPayload!
  logoutAdministrator(token: String!): Boolean!
  updateProfile(input: UpdateProfileInput!): Profile!
  sendMessage(roomID: ID!, content: String!): Message!
  createRoom(input: CreateRoomInput!): Room!
  getOrCreateDMRoom(targetUserID: ID!): Room!
  addUserToRoom(input: AddUserToRoomInput!): Boolean!
  removeUserFromRoom(input: RemoveUserFromRoomInput!): Boolean!
  createCommunity(input: CreateCommunityInput!): Community!
  joinRoom(roomID: ID!): Boolean!
}

input CreateAdministratorInput {
  name: String!
  email: String!
  password: String!
}

input UpdateAdministratorInput {
  name: String
  email: String
  password: String
}

input CreateUserInput {
  accountID: String!
  name: String!
  email: String!
  password: String!
}

input UpdateUserInput {
  name: String
  email: String
  password: String
}

type Profile {
  userID: String!
  user: User!
  username: String!
  bio: String
  grade: Int
  image: String
  createdAt: String!
  updatedAt: String!
}

input UpdateProfileInput {
  userID: String!
  username: String
  bio: String
  grade: Int
  image: String
}

type Room {
  ID: ID!
  name: String!
  type: String!
  user: [User!]!
  createdAt: String!
  updatedAt: String!
}

type Message {
  ID: ID!
  roomID: ID!
  room: Room!
  userID: ID!
  user: User!
  content: String!
  createdAt: String!
  updatedAt: String!
}

input CreateRoomInput {
  name: String!
}

input UpdateRoomInput {
  name: String
}

input AddUserToRoomInput {
  roomID: ID!
  userID: ID!
}

input RemoveUserFromRoomInput {
  roomID: ID!
  userID: ID!
}

type Community {
  ID: ID!
  roomID: ID!
  name: String!
  description: String!
  createdAt: String!
  updatedAt: String!
}

input CreateCommunityInput {
  name: String!
  description: String!
}

type Subscription {
  messageAdded(roomID: ID!): Message!
}
