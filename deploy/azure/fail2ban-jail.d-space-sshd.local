# /etc/fail2ban/jail.d/space-sshd.local へ置く。
#
# この VM は SSH のパスワード認証を開けたまま運用する（先生がパスワードで
# 入る必要がある）。開けている間は総当たりが常時来る。実測で7日間に
# 59,694 回の失敗があった。パスワードの強さだけで受けている状態なので、
# 試行そのものに上限を付ける。
#
# 鍵認証には影響しない。失敗しないものは数えられない。
[DEFAULT]
# 本人の打ち間違いは10分で解ける。繰り返す相手にだけ時間が伸びる
# （bantime.increment）。一律で長くすると、先生が5回間違えたときに
# 長時間締め出される。短い初期値＋逓増にしているのはそのため。
bantime  = 10m
findtime = 10m
maxretry = 5

bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w

# 自分自身は数えない。ここに外部の IP を足さないこと。足すとその IP からは
# 無制限に試せるようになり、この仕組みが効かない穴になる。
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
